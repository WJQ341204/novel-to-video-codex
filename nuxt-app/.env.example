# 复制为 .env 后按需修改（Nuxt 会自动加载，NUXT_PUBLIC_* 会覆盖 runtimeConfig.public）

# 后端 REST 地址。默认 /api —— dev 下由 nitro.devProxy 转到 http://localhost:8190/api
# NUXT_PUBLIC_API_BASE=http://localhost:8190/api

# 后端 WebSocket 地址。默认直连 ws://localhost:8190
# 原因：nitro.devProxy 的 ws:true 在 dev 下不生效（upgrade 不经过 devProxy），
#      生产环境请用 nginx 反代 /ws 后改成 wss://<域名>
# NUXT_PUBLIC_WS_BASE=ws://localhost:8190
